<component name="ProjectRunConfigurationManager">
  <!--
    Compiles only - nothing is flashed and no device has to be
    connected. The artifact to keep on a phone lands at:

      .esphome/build/janus-gate/build/firmware.ota.bin

    Upload it through the device's own web panel (ota: platform:
    web_server is enabled), which is the on-site update path: no
    laptop and no ESPHome toolchain needed at the gate.

    The documented use for this is the 433.42 MHz fallback. If
    learning hears nothing at all on site, the gate remote is
    probably on 433.42 rather than 433.92 - and rf_frequency cannot
    be changed without reflashing. Build that variant at home, carry
    the .bin, upload it through the browser.
  -->
  <configuration default="false" name="ESPHome: build OTA package" type="PythonConfigurationType" factoryName="Python" nameIsGenerated="false">
    <module name="janus-gate" />
    <option name="ENV_FILES" value="" />
    <option name="INTERPRETER_OPTIONS" value="" />
    <option name="PARENT_ENVS" value="true" />
    <envs>
      <env name="PYTHONUNBUFFERED" value="1" />
    </envs>
    <option name="SDK_HOME" value="" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="IS_MODULE_SDK" value="true" />
    <option name="ADD_CONTENT_ROOTS" value="true" />
    <option name="ADD_SOURCE_ROOTS" value="true" />
    <EXTENSION ID="PythonCoverageRunConfigurationExtension" runner="coverage.py" />
    <option name="SCRIPT_NAME" value="esphome" />
    <option name="PARAMETERS" value="compile janus-gate.yaml" />
    <option name="SHOW_COMMAND_LINE" value="false" />
    <option name="EMULATE_TERMINAL" value="true" />
    <option name="MODULE_MODE" value="true" />
    <option name="REDIRECT_INPUT" value="false" />
    <option name="INPUT_FILE" value="" />
    <method v="2" />
  </configuration>
</component>
